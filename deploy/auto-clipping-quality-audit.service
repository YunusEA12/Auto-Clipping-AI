[Unit]
Description=Auto-Clipping AI - next ten clips quality audit and twelve-hour checkpoint
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=autoclip
Group=autoclip
WorkingDirectory=/opt/auto-clipping-ai
Environment=PYTHONUNBUFFERED=1
Environment=AUTOCLIP_HOME=/opt/auto-clipping-ai
ExecStart=/opt/auto-clipping-ai/venv/bin/python -m autoclip.quality.clip_quality_audit --watch
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/auto-clipping-ai
PrivateTmp=true

[Install]
WantedBy=multi-user.target
