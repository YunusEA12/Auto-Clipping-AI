[Unit]
Description=Auto-Clipping AI - Streamlit dashboard (Tailscale-only access, see SETUP_SERVER.md)
After=network-online.target tailscaled.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=autoclip
Group=autoclip
WorkingDirectory=/opt/auto-clipping-ai
# 0.0.0.0 is required here so the dashboard is reachable on the tailscale0 interface, not
# just localhost - it does NOT mean "publicly exposed": SETUP_SERVER.md's ufw rules block
# every interface except tailscale0 and SSH by default. Keep those firewall rules.
# DASHBOARD_PASSWORD provides an additional login gate, configured in the private .env.
# The browser path matches the supervisor for explicitly requested manual publishing.
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/auto-clipping-ai/.playwright-browsers
Environment=AUTOCLIP_HOME=/opt/auto-clipping-ai
ExecStart=/opt/auto-clipping-ai/venv/bin/autoclip dashboard --server.address 0.0.0.0 --server.port 8501 --server.headless true --browser.gatherUsageStats false
Restart=on-failure
RestartSec=15

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/auto-clipping-ai
PrivateTmp=true

[Install]
WantedBy=multi-user.target
