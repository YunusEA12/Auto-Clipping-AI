# OpenAI API key used for LLM clip analysis (analyze.py)
OPENAI_API_KEY=sk-...

# Discord webhook URL for clip render/upload notifications (notify.py)
# Create one under Server Settings -> Integrations -> Webhooks in Discord.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Optional: TikTok app credentials as a .env alternative to tiktok_client_secret.json
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
