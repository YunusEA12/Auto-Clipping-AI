# Gemini API key used for LLM clip analysis and the vision/text critic (analyze.py, train_loop.py)
GEMINI_API_KEY=...

# Optional: overrides llm_utils.py's fleet-wide daily Gemini call ceiling (default 500, see
# llm_utils.DEFAULT_MAX_CALLS_PER_DAY's own comment). 500 is Google's actual free-tier daily
# request quota for gemini-3.5-flash-lite (GenerateRequestsPerDayPerProjectPerModel-FreeTier)
# -- NOT just a self-imposed spend guard. Raising this above your real Gemini plan's daily
# quota does not create more capacity; it only lets the fleet burn real network round-trips
# and retries on requests that are guaranteed to 429 until Google's own quota window resets.
# Only raise this after upgrading the Gemini API key off the free tier, to match the new
# plan's actual daily quota.
GEMINI_DAILY_CALL_BUDGET=500

# CPU threads per streamer (default 2; bounded by available cores).
WHISPER_CPU_THREADS=2

# Discord webhook URL for clip render/upload notifications (notify.py)
# Create one under Server Settings -> Integrations -> Webhooks in Discord.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Optional: TikTok app credentials as a .env alternative to tiktok_client_secret.json
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# TikTok posting limits (upload_manager.py). Defaults protect a fresh account: at most 4 upload
# attempts per day, at least 3 hours apart. 0 disables the daily cap. Raise slowly.
TIKTOK_DAILY_UPLOAD_CAP=4
TIKTOK_MIN_UPLOAD_INTERVAL_SECONDS=10800
